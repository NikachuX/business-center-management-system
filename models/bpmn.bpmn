<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:storm="http://storm.bpmn2.ru/ns" id="Definitions_Lease" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Claude" exporterVersion="1.1">
  <bpmn:collaboration id="Collaboration_Lease">
    <bpmn:participant id="Participant_Tenant" name="Арендатор" />
    <bpmn:participant id="Participant_BC" name="Бизнес-центр (арендодатель)" processRef="Process_Lease" />
    <bpmn:messageFlow id="MF01" sourceRef="Participant_Tenant" targetRef="Start_Request" />
    <bpmn:messageFlow id="MF02" sourceRef="Task_SendOffer" targetRef="Participant_Tenant" />
    <bpmn:messageFlow id="MF03" sourceRef="Participant_Tenant" targetRef="Catch_OfferReply" />
    <bpmn:messageFlow id="MF04" sourceRef="Task_NotifyRefusal" targetRef="Participant_Tenant" />
    <bpmn:messageFlow id="MF05" sourceRef="Task_SendContract" targetRef="Participant_Tenant" />
    <bpmn:messageFlow id="MF06" sourceRef="Participant_Tenant" targetRef="Catch_ContractReply" />
    <bpmn:messageFlow id="MF07" sourceRef="Task_SendForSign" targetRef="Participant_Tenant" />
    <bpmn:messageFlow id="MF08" sourceRef="Participant_Tenant" targetRef="Catch_Signed" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Lease" name="Обработка заявки арендатора и заключение договора аренды коммерческого помещения" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_Manager" name="Менеджер по аренде">
        <bpmn:flowNodeRef>Start_Request</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RegisterRequest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_MergeSelect</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SelectPremises</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_PremisesFound</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_NotifyRefusal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_NoPremises</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PrepareOffer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendOffer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Catch_OfferReply</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_TenantDecision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CloseRequest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Closed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_MergeContract</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendContract</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Catch_ContractReply</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_TenantRemarks</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AgreeRemarks</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendForSign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Catch_Signed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_UpdateRecords</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Done</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_01xfho1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_06icvkw</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_1i5kgd1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Lawyer" name="Юрист">
        <bpmn:flowNodeRef>Task_CheckTenant</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_TenantOk</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Rejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CheckContract</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_ContractOk</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Director" name="Управляющий бизнес-центра">
        <bpmn:flowNodeRef>Task_ApproveContract</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SignLandlord</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_Request" name="Получена заявка арендатора">
      <bpmn:outgoing>F01</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Start_Request_msg" />
    </bpmn:startEvent>
    <bpmn:task id="Task_RegisterRequest" name="Зарегистрировать заявку">
      <bpmn:incoming>F01</bpmn:incoming>
      <bpmn:outgoing>F02</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="Out_Request">
        <bpmn:targetRef>DOR_Request</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:task id="Task_CheckTenant" name="Проверить арендатора">
      <bpmn:incoming>F02</bpmn:incoming>
      <bpmn:outgoing>F03</bpmn:outgoing>
      <bpmn:dataInputAssociation id="In_Request">
        <bpmn:sourceRef>DOR_Request</bpmn:sourceRef>
      </bpmn:dataInputAssociation>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gw_TenantOk" name="Арендатор прошёл проверку?">
      <bpmn:incoming>F03</bpmn:incoming>
      <bpmn:outgoing>F04</bpmn:outgoing>
      <bpmn:outgoing>F05</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_Rejected" name="Заявка отклонена">
      <bpmn:incoming>F05</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="Gw_MergeSelect">
      <bpmn:incoming>F04</bpmn:incoming>
      <bpmn:incoming>F17</bpmn:incoming>
      <bpmn:outgoing>F06</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_SelectPremises" name="Подобрать свободные помещения">
      <bpmn:incoming>F06</bpmn:incoming>
      <bpmn:outgoing>F07</bpmn:outgoing>
      <bpmn:property id="Property_0jakl1t" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="DataInputAssociation_07ae6sf">
        <bpmn:sourceRef>DataObjectReference_07yawiy</bpmn:sourceRef>
        <bpmn:targetRef>Property_0jakl1t</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gw_PremisesFound" name="Есть подходящие помещения?">
      <bpmn:incoming>F07</bpmn:incoming>
      <bpmn:outgoing>F08</bpmn:outgoing>
      <bpmn:outgoing>F09</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="Task_NotifyRefusal" name="Сообщить арендатору об отказе">
      <bpmn:incoming>F09</bpmn:incoming>
      <bpmn:outgoing>F10</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="End_NoPremises" name="Заявка закрыта: нет помещений">
      <bpmn:incoming>F10</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="Task_PrepareOffer" name="Сформировать коммерческое предложение">
      <bpmn:incoming>Flow_0vl64x9</bpmn:incoming>
      <bpmn:outgoing>F12</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="Out_Offer">
        <bpmn:targetRef>DOR_Offer</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:sendTask id="Task_SendOffer" name="Направить коммерческое предложение арендатору">
      <bpmn:incoming>F12</bpmn:incoming>
      <bpmn:outgoing>F13</bpmn:outgoing>
      <bpmn:dataInputAssociation id="In_Offer">
        <bpmn:sourceRef>DOR_Offer</bpmn:sourceRef>
      </bpmn:dataInputAssociation>
    </bpmn:sendTask>
    <bpmn:intermediateCatchEvent id="Catch_OfferReply" name="Получен ответ арендатора">
      <bpmn:incoming>F13</bpmn:incoming>
      <bpmn:outgoing>F14</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Catch_OfferReply_msg" />
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="Gw_TenantDecision" name="Решение арендатора?">
      <bpmn:incoming>F14</bpmn:incoming>
      <bpmn:outgoing>F15</bpmn:outgoing>
      <bpmn:outgoing>F16</bpmn:outgoing>
      <bpmn:outgoing>F17</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_CloseRequest" name="Закрыть заявку и снять резерв">
      <bpmn:incoming>F16</bpmn:incoming>
      <bpmn:outgoing>F18</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_Closed" name="Заявка закрыта: арендатор отказался">
      <bpmn:incoming>F18</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="Gw_MergeContract">
      <bpmn:incoming>F15</bpmn:incoming>
      <bpmn:incoming>Flow_03nsu3e</bpmn:incoming>
      <bpmn:outgoing>Flow_1e6bdv4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_CheckContract" name="Проверить проект договора">
      <bpmn:incoming>Flow_0ltm3i2</bpmn:incoming>
      <bpmn:outgoing>F21</bpmn:outgoing>
      <bpmn:dataInputAssociation id="In_Contract">
        <bpmn:sourceRef>DOR_Contract</bpmn:sourceRef>
      </bpmn:dataInputAssociation>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gw_ContractOk" name="Замечания юриста есть?">
      <bpmn:incoming>F21</bpmn:incoming>
      <bpmn:outgoing>F23</bpmn:outgoing>
      <bpmn:outgoing>Flow_0cjmdw9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_ApproveContract" name="Согласовать договор">
      <bpmn:incoming>F23</bpmn:incoming>
      <bpmn:outgoing>F24</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sendTask id="Task_SendContract" name="Направить проект договора арендатору">
      <bpmn:incoming>F24</bpmn:incoming>
      <bpmn:outgoing>F25</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:intermediateCatchEvent id="Catch_ContractReply" name="Получен ответ арендатора по договору">
      <bpmn:incoming>F25</bpmn:incoming>
      <bpmn:outgoing>F26</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Catch_ContractReply_msg" />
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="Gw_TenantRemarks" name="Есть замечания арендатора?">
      <bpmn:incoming>F26</bpmn:incoming>
      <bpmn:outgoing>F27</bpmn:outgoing>
      <bpmn:outgoing>F28</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_AgreeRemarks" name="Согласовать замечания арендатора">
      <bpmn:incoming>F27</bpmn:incoming>
      <bpmn:outgoing>F29</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_SignLandlord" name="Подписать договор от имени арендодателя">
      <bpmn:incoming>F28</bpmn:incoming>
      <bpmn:outgoing>F30</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sendTask id="Task_SendForSign" name="Передать договор арендатору на подписание">
      <bpmn:incoming>F30</bpmn:incoming>
      <bpmn:outgoing>F31</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:intermediateCatchEvent id="Catch_Signed" name="Получен подписанный арендатором договор">
      <bpmn:incoming>F31</bpmn:incoming>
      <bpmn:outgoing>F32</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Catch_Signed_msg" />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="Task_UpdateRecords" name="Актуализировать сведения о помещении и условиях аренды">
      <bpmn:incoming>F32</bpmn:incoming>
      <bpmn:outgoing>F33</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="Out_Records">
        <bpmn:targetRef>DOR_Records</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:endEvent id="End_Done" name="Договор аренды заключён">
      <bpmn:incoming>F33</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F01" sourceRef="Start_Request" targetRef="Task_RegisterRequest" />
    <bpmn:sequenceFlow id="F02" sourceRef="Task_RegisterRequest" targetRef="Task_CheckTenant" />
